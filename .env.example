# ── Supabase (Project Settings → API) ───────────────────────────────────────
# Both are safe in the browser: the publishable key is designed to ship to
# clients, and Row Level Security is what actually protects your data.
#
# Use the key labelled "publishable" (sb_publishable_…) or the legacy "anon"
# JWT. NEVER the one labelled "secret" / "service_role" — a VITE_ variable is
# compiled into the JavaScript every visitor downloads, so a secret key placed
# here is a secret key published to the internet.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# ── Server-side secrets — never in this file ────────────────────────────────
# The Anthropic and Plaid keys live only as Supabase Edge Function secrets, so
# they stay on the server and out of the bundle:
#
#   npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   npx supabase secrets set PLAID_CLIENT_ID=... PLAID_SECRET=... PLAID_ENV=sandbox
#
# There is deliberately no VITE_ANTHROPIC_API_KEY. An earlier version of this
# app called Anthropic from the browser; the `chat` Edge Function replaced it
# precisely so the key would stop shipping to users.

# ── Feature flags ───────────────────────────────────────────────────────────
# Bank linking via Plaid is built and tested, but Plaid gates production access
# behind its own review. Leave this unset for the Play release: onboarding then
# shows manual entry only, instead of a dev-facing "not configured" notice or a
# sandbox that accepts only fake credentials.
#
# The Android app is a Trusted Web Activity, so it renders live web content.
# Setting this to true and deploying turns the feature on for everyone who has
# already installed it — no new bundle, no Play release, no re-review.
VITE_ENABLE_BANK_LINKING=false
