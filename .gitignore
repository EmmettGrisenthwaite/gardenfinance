# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env
# Any variant — .env.local, .env.production, and the .env.bak someone makes
# before editing. The template is the one file here that must stay tracked.
.env.*
!.env.example

# Local-only Supabase deploy token (never commit)
.supabase-token
supabase/.env.deploy

# Supabase CLI scratch state — rewritten on every CLI invocation, not source
supabase/.temp/

# Local agent/editor config + Office lock files
.claude/
~$*
.vercel

# Android signing key. Losing this file means never being able to update the
# Play listing again; committing it means anyone can publish as you.
*.keystore
*.jks
android.keystore

# Bubblewrap build output — regenerated from twa-manifest.json
/app/
*.aab
*.apk
